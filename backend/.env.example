# DataPulse Backend Environment Variables

# Optional: Grok API Key for AI Copilot
# Get your key from: https://console.x.ai
GROK_API_KEY=your_grok_api_key_here

# Razorpay Payment Gateway
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Encryption key for secure credential storage (64 hex characters)
DATAPULSE_ENCRYPTION_KEY=your_64_char_hex_key_here

# Server port (default: 3001)
PORT=3001
